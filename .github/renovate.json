{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>aonyx-ai/renovate-config",
    "github>aonyx-ai/rakko-update"
  ],
  "customManagers": [
    {
      "description": "Update the release of mise that the action installs. The preset of the organization reads these comments only below `.github`, and the action lives at the root of the repository.",
      "customType": "regex",
      "managerFilePatterns": ["action.yml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+version: [\"']?(?<currentValue>.+?)[\"']?\\s"
      ]
    }
  ]
}
